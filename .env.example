# 复制成 .env 后填写（.env 已在 .gitignore 里，不会进仓库）
# docker compose 会自动读取同目录的 .env

# ---------- 文本对话 + Function Calling（必填）----------
LLM_BASE_URL=https://api.deepseek.com
LLM_MODEL=deepseek-chat
LLM_API_KEY=

# ---------- RAG 检索（留空则降级为本地词法向量，检索质量会明显下降）----------
# 同时用于向量模型（text-embedding-v4）与精排（gte-rerank-v2）
RAG_EMBEDDING_API_KEY=
RAG_RERANK_ENABLED=true

# ---------- 数据库 / 管理面 ----------
MYSQL_PASSWORD=ai_ilink123
# 管理 API 的鉴权头（/api/**），生产环境务必改掉
MANAGEMENT_API_TOKEN=change-me-in-production

# ---------- 可选能力（不填则对应工具不可用）----------
# LLM_VISION_API_KEY=
# LLM_DRAW_API_KEY=
# LLM_TTS_API_KEY=
# LLM_STT_API_KEY=
# WEATHER_API_KEY=
# LLM_SEARCH_KEY=
# TIANYANCHA_API_KEY=
